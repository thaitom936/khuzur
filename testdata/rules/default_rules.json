{
  "name": "default rules: deal, decide, exchange, then swap the trump seven, then play",
  "players": 2,
  "dealer": 0,
  "hands": [
    ["AC", "KC", "QC", "JC", "TH"],
    ["9C", "8C", "AD", "7H", "7D"]
  ],
  "trump": "KH",
  "stock": [],
  "steps": [
    {"expect": {"phase": "deciding", "turn": 1}},
    {"swap": {"seat": 1}, "error": "wrong_phase"},
    {"decide": {"seat": 1, "play": true}},
    {"decide": {"seat": 0, "play": true}},
    {"expect": {"phase": "exchanging", "turn": 1, "trump": "KH"}},

    {"exchange": {"seat": 1, "cards": []}},
    {"exchange": {"seat": 0, "cards": []}},
    {"expect": {"phase": "swapping", "turn": 1}},

    {"swap": {"seat": 0}, "error": "not_your_turn"},
    {"swap": {"seat": 1}},
    {"expect": {"phase": "playing", "turn": 1, "trickNo": 1, "trump": "7H",
                "hand": {"seat": 1, "cards": ["9C", "8C", "AD", "KH", "7D"]}}},

    {"play": {"seat": 1, "card": "9C"}},
    {"legal": {"seat": 0, "cards": ["JC", "QC", "KC", "AC"]}},
    {"play": {"seat": 0, "card": "JC"}},
    {"expect": {"turn": 0, "trickNo": 2, "tricks": [1, 0]}},

    {"play": {"seat": 0, "card": "AC"}},
    {"legal": {"seat": 1, "cards": ["8C"]}},
    {"play": {"seat": 1, "card": "8C"}},
    {"expect": {"turn": 0, "tricks": [2, 0]}},

    {"play": {"seat": 0, "card": "KC"}},
    {"legal": {"seat": 1, "cards": ["KH"]}},
    {"play": {"seat": 1, "card": "7D"}, "error": "illegal_card"},
    {"play": {"seat": 1, "card": "KH"}},
    {"expect": {"turn": 1, "trickNo": 4, "tricks": [2, 1]}},

    {"play": {"seat": 1, "card": "AD"}},
    {"legal": {"seat": 0, "cards": ["TH"]}},
    {"play": {"seat": 0, "card": "TH"}},
    {"expect": {"turn": 0, "trickNo": 5, "tricks": [3, 1]}},

    {"play": {"seat": 0, "card": "QC"}},
    {"legal": {"seat": 1, "cards": ["7D"]}},
    {"play": {"seat": 1, "card": "7D"}},

    {"expect": {"phase": "round_end", "tricks": [4, 1], "scores": [11, 14]}}
  ]
}
