-- bot-room keeper test: fast timers, 2 showcase rooms
root = "./"
thread = 4
harbor = 0
start = "test_botrooms"
bootstrap = "snlua bootstrap"
logger = nil
logpath = "."

luaservice = root.."service/?.lua;"..root.."test/?.lua;"..root.."skynet/service/?.lua"
lualoader = root.."skynet/lualib/loader.lua"
lua_path = root.."lualib/?.lua;"..root.."skynet/lualib/?.lua;"..root.."skynet/lualib/?/init.lua"
lua_cpath = root.."skynet/luaclib/?.so"
cpath = root.."skynet/cservice/?.so"

ws_port = 9621
agent_pool = 2

redis_host = "127.0.0.1"
redis_port = 6379
redis_db = 2

timeout_decide = 100
timeout_exchange = 100
timeout_play = 100
bot_delay = 5
bot_delay_max = 10
bot_join_grace = 200
bot_join_interval = 40
round_pause = 10
quick_size = 4
match_min_humans = 1
match_fill_after = 20
stakes_enabled = "false"
bot_rooms = 2
