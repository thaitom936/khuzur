-- e2e test config: fast timers, separate port and redis db
root = "./"
thread = 4
harbor = 0
start = "test_e2e"
bootstrap = "snlua bootstrap"
logger = nil
logpath = "."

luaservice = root.."service/?.lua;"..root.."test/?.lua;"..root.."skynet/service/?.lua"
lualoader = root.."skynet/lualib/loader.lua"
lua_path = root.."lualib/?.lua;"..root.."skynet/lualib/?.lua;"..root.."skynet/lualib/?/init.lua"
lua_cpath = root.."skynet/luaclib/?.so"
cpath = root.."skynet/cservice/?.so"

ws_port = 9611
agent_pool = 2

mysql_host = "127.0.0.1"
mysql_port = 3306
mysql_db = "khuzur"
mysql_user = "khuzur"
mysql_password = "khuzur_dev_2026"

redis_host = "127.0.0.1"
redis_port = 6379
redis_db = 2

timeout_decide = 100
timeout_exchange = 100
timeout_play = 100
bot_delay = 5
round_pause = 10
quick_size = 4
match_min_humans = 1 -- tests exercise the bot-fill path
match_fill_after = 20
