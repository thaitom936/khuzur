# Copy to server/.env on each server. Never commit credentials or ship in Flutter.
# This file is sourced by /bin/sh; quote values containing shell characters.

# Agora realtime voice/video (optional).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_PORT=9760

# Cloudflare R2 chat attachments (optional). Keep the bucket private.
R2_ACCOUNT_ID=
R2_BUCKET=khuzur
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CHAT_MEDIA_PORT=9761

# Optional platform moderators: comma-separated existing user IDs.
CHAT_ADMIN_UIDS=
